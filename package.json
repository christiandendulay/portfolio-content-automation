{
  "name": "portfolion-contentful-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "sort-package-json && prettier --write \"**/*.{js,json,md,yml}\" && node scripts/sort-json.js",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\"",
    "migrate": "node -r dotenv/config migrations/run-migrations.js",
    "export:model": "node scripts/export-model.js",
    "generate:migration": "node scripts/generate-migration.js content-model-export.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.2.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.2.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "contentful-cli": "^4.0.1",
    "contentful-migration": "^5.0.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3",
    "prettier-plugin-sort-json": "^4.2.0",
    "sort-package-json": "^3.7.0"
  }
}
